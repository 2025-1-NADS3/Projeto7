<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Recarga">

    <!-- Botão de voltar -->
    <ImageView
        android:id="@+id/img_voltar"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_marginStart="30dp"
        android:layout_marginTop="30dp"
        app:srcCompat="@drawable/btn_voltar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Conteúdo rolável -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/img_voltar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="30dp"
            android:paddingTop="40dp"
            android:paddingEnd="30dp">

            <!-- Título -->
            <TextView
                android:id="@+id/txt_titulo_recarga"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Recarga"
                android:textSize="26sp"
                android:textColor="#1E1E2D"
                android:fontFamily="@font/poppinsbold" />

            <!-- Subtítulo -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Valor"
                android:textSize="18sp"
                android:textColor="#1E1E2D"
                android:layout_marginTop="30dp"
                android:fontFamily="@font/poppinsbold" />

            <!-- Botões de valores rápidos -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="10dp"
                android:gravity="center_horizontal"
                android:weightSum="4">

                <Button
                    android:id="@+id/btn10"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/borda_cinza"
                    android:backgroundTint="#FFFFFF"
                    android:fontFamily="@font/poppinsmedium"
                    android:text="R$ 10"
                    android:textColor="#000"
                    android:textSize="12dp" />

                <Button
                    android:id="@+id/btn20"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/borda_cinza"
                    android:backgroundTint="#FFFFFF"
                    android:fontFamily="@font/poppinsmedium"
                    android:text="R$ 20"
                    android:textColor="#000"
                    android:textSize="12dp" />

                <Button
                    android:id="@+id/btn50"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/borda_cinza"
                    android:backgroundTint="#FFFFFF"
                    android:fontFamily="@font/poppinsmedium"
                    android:text="R$ 50"
                    android:textColor="#000"
                    android:textSize="11dp" />

                <Button
                    android:id="@+id/btn100"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/borda_cinza"
                    android:backgroundTint="#FFFFFF"
                    android:fontFamily="@font/poppinsmedium"
                    android:text="R$ 100"
                    android:textColor="#000"
                    android:textSize="10dp" />
            </LinearLayout>

            <!-- Campo personalizado de valor -->

            <!-- NOVA SEÇÃO: Forma de Pagamento -->
            <EditText
                android:id="@+id/input_valor_recarga"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/borda_cinza"
                android:fontFamily="@font/poppinsbold"
                android:gravity="center"
                android:hint="R$ 0,00"
                android:inputType="numberDecimal"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/txt_forma_pagamento"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Forma de Pagamento"
                android:textSize="18sp"
                android:textColor="#1E1E2D"
                android:layout_marginTop="30dp"
                android:fontFamily="@font/poppinsbold" />

            <RadioGroup
                android:id="@+id/radioGroupMetodo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="20dp">

                <RadioButton
                    android:id="@+id/radioPix"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pix" />

                <RadioButton
                    android:id="@+id/radioCartao"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cartão"
                    android:layout_marginStart="30dp" />
            </RadioGroup>

            <!-- Botão continuar -->
            <Button
                android:id="@+id/btn_continuar"
                android:layout_width="match_parent"
                android:layout_height="63dp"
                android:layout_marginTop="30dp"
                android:backgroundTint="#20403D"
                android:text="Continuar"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:fontFamily="@font/poppinsmedium"
                app:cornerRadius="15dp" />
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
