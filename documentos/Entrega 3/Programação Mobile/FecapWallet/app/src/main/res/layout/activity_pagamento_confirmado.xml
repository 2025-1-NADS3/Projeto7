<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".PagamentoConfirmado"
    android:background="#FFFFFF">

    <!-- Ícone de sucesso -->
    <ImageView
        android:id="@+id/img_pagamento_sucesso"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_marginTop="80dp"
        app:srcCompat="@drawable/ic_sucesso"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Texto principal -->

    <!-- Valor confirmado -->

    <TextView
        android:id="@+id/txt_pagamento_sucesso"
        android:layout_width="414dp"
        android:layout_height="45dp"
        android:fontFamily="@font/poppinsbold"
        android:text="Pagamento realizado com sucesso!"
        android:textColor="#1E1E2D"
        android:textSize="22sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.493"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.355" />

    <TextView
        android:id="@+id/txt_valor_confirmado"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="R$ 50,00"
        android:textSize="20sp"
        android:textColor="#20403D"
        android:layout_marginTop="12dp"
        android:fontFamily="@font/poppinsmedium"
        app:layout_constraintTop_toBottomOf="@id/txt_pagamento_sucesso"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Botão para voltar à tela inicial -->

    <TextView
        android:id="@+id/textValorRecebido"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Chave Pix:"
        android:textSize="18sp"
        android:textColor="#20403D"
        android:fontFamily="@font/poppinsmedium"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.48" />

    <Button
        android:id="@+id/btnVoltarInicio"
        android:layout_width="250dp"
        android:layout_height="55dp"
        android:text="Voltar ao Início"
        android:layout_marginTop="58dp"
        android:backgroundTint="#20403D"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:fontFamily="@font/poppinsmedium"
        app:cornerRadius="15dp"
        app:layout_constraintTop_toBottomOf="@id/txt_valor_confirmado"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>