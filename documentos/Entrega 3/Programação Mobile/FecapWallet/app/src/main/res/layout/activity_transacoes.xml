<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Activity_Transacoes">

    <!-- Header (barra superior com botão voltar e título "Perfil") -->
    <LinearLayout
        android:id="@+id/linearLayout3"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.030">

        <ImageButton
            android:id="@+id/btnVoltar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/btn_voltar" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:fontFamily="@font/poppinsbold"
            android:gravity="center"
            android:text="Histórico de Transações"
            android:textColor="#20403D"
            android:textSize="24sp" />
    </LinearLayout>

    <!-- Extrato -->
    <TextView
        android:id="@+id/textView5"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="8dp"
        android:fontFamily="@font/poppinsbold"
        android:text="Hoje"
        android:textAlignment="textStart"
        app:layout_constraintBottom_toTopOf="@+id/linearLayoutGastos"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Gastos -->
    <LinearLayout
        android:id="@+id/linearLayoutGastos"
        android:layout_width="0dp"
        android:layout_height="500dp"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@+id/linearLayout2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.70">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/refeicaoicon"
                android:layout_width="30dp"
                android:layout_height="54dp"
                android:textAlignment="center"
                app:srcCompat="@drawable/cantina" />

            <TextView
                android:id="@+id/cantina"
                android:layout_width="50dp"
                android:layout_height="match_parent"
                android:layout_margin="7dp"
                android:layout_weight="1"
                android:fontFamily="@font/poppinsregular"
                android:gravity="center"
                android:text="Cantina"
                android:textAlignment="viewStart"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:ignore="RtlCompat" />

            <TextView
                android:id="@+id/valorcantina"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="-----"
                android:textAlignment="center" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/mensalidadeicon"
                android:layout_width="30dp"
                android:layout_height="match_parent"
                app:srcCompat="@drawable/mensalidade" />

            <TextView
                android:id="@+id/mensalidade"
                android:layout_width="50dp"
                android:layout_height="match_parent"
                android:layout_margin="7dp"
                android:layout_weight="1"
                android:fontFamily="@font/poppinsregular"
                android:gravity="center"
                android:text="Mensalidade"
                android:textAlignment="viewStart"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:ignore="RtlCompat" />

            <TextView
                android:id="@+id/valormensalidade"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="-----"
                android:textAlignment="center" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/transferenciaicon"
                android:layout_width="30dp"
                android:layout_height="match_parent"
                app:srcCompat="@drawable/dinheiro" />

            <TextView
                android:id="@+id/transferencia"
                android:layout_width="50dp"
                android:layout_height="match_parent"
                android:layout_margin="7dp"
                android:layout_weight="1"
                android:fontFamily="@font/poppinsregular"
                android:gravity="center"
                android:text="Dinheiro transferido"
                android:textAlignment="viewStart"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:ignore="RtlCompat" />

            <TextView
                android:id="@+id/valortransferencia"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="-----"
                android:textAlignment="center" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/exameicon"
                android:layout_width="30dp"
                android:layout_height="match_parent"
                app:srcCompat="@drawable/exame" />

            <TextView
                android:id="@+id/exame"
                android:layout_width="50dp"
                android:layout_height="match_parent"
                android:layout_margin="7dp"
                android:layout_weight="1"
                android:fontFamily="@font/poppinsregular"
                android:gravity="center"
                android:text="Exame"
                android:textAlignment="viewStart"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:ignore="RtlCompat" />

            <TextView
                android:id="@+id/valorexame"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="-----"
                android:textAlignment="center" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/roupaicon4"
                android:layout_width="30dp"
                android:layout_height="match_parent"
                app:srcCompat="@drawable/roupa" />

            <TextView
                android:id="@+id/roupa4"
                android:layout_width="50dp"
                android:layout_height="match_parent"
                android:layout_margin="7dp"
                android:layout_weight="1"
                android:fontFamily="@font/poppinsregular"
                android:gravity="center"
                android:text="Lojinha Fecap"
                android:textAlignment="viewStart"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:ignore="RtlCompat" />

            <TextView
                android:id="@+id/valorroupa4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="-----"
                android:textAlignment="center" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/lojinhaicon2"
                android:layout_width="30dp"
                android:layout_height="match_parent"
                app:srcCompat="@drawable/roupa" />

            <TextView
                android:id="@+id/roupa2"
                android:layout_width="50dp"
                android:layout_height="match_parent"
                android:layout_margin="7dp"
                android:layout_weight="1"
                android:fontFamily="@font/poppinsregular"
                android:gravity="center"
                android:text="Camiseta FECAP"
                android:textAlignment="viewStart"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:ignore="RtlCompat" />

            <TextView
                android:id="@+id/valorroupa2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="-----"
                android:textAlignment="center" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/exameicon3"
                android:layout_width="30dp"
                android:layout_height="match_parent"
                app:srcCompat="@drawable/exame" />

            <TextView
                android:id="@+id/exametext3"
                android:layout_width="50dp"
                android:layout_height="match_parent"
                android:layout_margin="7dp"
                android:layout_weight="1"
                android:fontFamily="@font/poppinsregular"
                android:gravity="center"
                android:text="Exame"
                android:textAlignment="viewStart"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:ignore="RtlCompat" />

            <TextView
                android:id="@+id/valorexame2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="-----"
                android:textAlignment="center" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/cantinaicon3"
                android:layout_width="30dp"
                android:layout_height="match_parent"
                app:srcCompat="@drawable/cantina" />

            <TextView
                android:id="@+id/cantina3"
                android:layout_width="50dp"
                android:layout_height="match_parent"
                android:layout_margin="7dp"
                android:layout_weight="1"
                android:fontFamily="@font/poppinsregular"
                android:gravity="center"
                android:text="Cantina"
                android:textAlignment="viewStart"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:ignore="RtlCompat" />

            <TextView
                android:id="@+id/valorcantina2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="-----"
                android:textAlignment="center" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/roupaicon"
                android:layout_width="30dp"
                android:layout_height="match_parent"
                app:srcCompat="@drawable/roupa" />

            <TextView
                android:id="@+id/roupa"
                android:layout_width="50dp"
                android:layout_height="match_parent"
                android:layout_margin="7dp"
                android:layout_weight="1"
                android:fontFamily="@font/poppinsregular"
                android:gravity="center"
                android:text="Lojinha Fecap"
                android:textAlignment="viewStart"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:ignore="RtlCompat" />

            <TextView
                android:id="@+id/valorroupa"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="-----"
                android:textAlignment="center" />
        </LinearLayout>

    </LinearLayout>

    <!-- Barra inferior -->
    <LinearLayout
        android:id="@+id/linearLayout2"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:background="#E3DFDF"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="1.0">

        <!-- HOME -->
        <LinearLayout
            android:id="@+id/btnHomeLayout"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">


            <ImageButton
                android:id="@+id/imageButton2"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:background="@null"
                app:srcCompat="@drawable/homeverde" />

            <TextView
                android:id="@+id/textView10"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Home"
                />
        </LinearLayout>

        <!-- MEU CARTÃO -->
        <LinearLayout
            android:id="@+id/btnMeuCartaoLayout"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">

            <ImageButton
                android:id="@+id/meucartaoicon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:background="@null"
                app:srcCompat="@drawable/cardcinza" />

            <TextView
                android:id="@+id/meucartao"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Meu Cartão" />
        </LinearLayout>

        <!-- TRANSAÇÕES -->
        <LinearLayout
            android:id="@+id/btnTransacoesLayout"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">

            <ImageButton
                android:id="@+id/estatisticasbutton"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:background="@null"
                app:srcCompat="@drawable/estatisticacinza" />

            <TextView
                android:id="@+id/estatisticas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Transações"
                android:textColor="#20403D"/>
        </LinearLayout>

        <!-- CONFIGURAÇÕES -->
        <LinearLayout
            android:id="@+id/btnConfiguracoesLayout"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">

            <ImageButton
                android:id="@+id/configbutton"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:background="@null"
                app:srcCompat="@drawable/configcinza" />

            <TextView
                android:id="@+id/configuracoes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Configurações" />
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>