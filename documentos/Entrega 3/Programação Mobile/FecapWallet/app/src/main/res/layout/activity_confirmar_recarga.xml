<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ConfirmarRecarga"
    android:background="#FFFFFF">

    <!-- Botão de voltar -->
    <ImageView
        android:id="@+id/img_voltar"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_marginStart="30dp"
        android:layout_marginTop="30dp"
        app:srcCompat="@drawable/btn_voltar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Conteúdo principal -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="30dp"
        android:paddingEnd="30dp"
        android:paddingTop="50dp"
        app:layout_constraintTop_toBottomOf="@id/img_voltar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Título -->
        <TextView
            android:id="@+id/txt_titulo_confirmacao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Confirmar Recarga"
            android:textSize="24sp"
            android:textColor="#1E1E2D"
            android:fontFamily="@font/poppinsbold" />

        <!-- Valor -->
        <TextView
            android:id="@+id/txt_valor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Valor: R$ 50,00"
            android:textSize="20sp"
            android:textColor="#20403D"
            android:layout_marginTop="30dp"
            android:fontFamily="@font/poppinsbold" />

        <!-- Número de telefone (se aplicável) -->
        <TextView
            android:id="@+id/txt_numero"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Número: (11) 91234-5678"
            android:textSize="16sp"
            android:textColor="#7E848D"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/poppinsmedium" />

        <!-- Mensagem de confirmação -->
        <TextView
            android:id="@+id/txt_confirmar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Deseja confirmar essa recarga?"
            android:textSize="16sp"
            android:textColor="#1E1E2D"
            android:layout_marginTop="30dp"
            android:fontFamily="@font/poppinsregular" />

        <!-- Botões de ação -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="40dp">

            <!-- Confirmar -->
            <Button
                android:id="@+id/btn_confirmar"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="55dp"
                android:text="Confirmar"
                android:textColor="#FFFFFF"
                android:backgroundTint="#20403D"
                android:fontFamily="@font/poppinsmedium"
                app:cornerRadius="15dp" />

            <!-- Espaço entre botões -->
            <Space
                android:layout_width="16dp"
                android:layout_height="0dp" />

            <!-- Cancelar -->
            <Button
                android:id="@+id/btn_cancelar"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="55dp"
                android:text="Cancelar"
                android:textColor="#FFFFFF"
                android:backgroundTint="#7E848D"
                android:fontFamily="@font/poppinsmedium"
                app:cornerRadius="15dp" />

        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>